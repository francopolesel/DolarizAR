{
  "manifest_version": 3,
  "name": "DolarizAR",
  "version": "1.5.2",
  "description": "Detecta precios en pesos argentinos (ARS) y muestra su equivalente en dólares (dólar oficial).",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DolarizAR",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["utils/currency.js", "utils/price-detector.js", "utils/storage.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://dolarapi.com/*"]
}
